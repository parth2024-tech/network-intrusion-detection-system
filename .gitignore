# NIDS Project — .gitignore

# Data (never commit raw or processed data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Trained models (large binary files)
models/*
!models/.gitkeep
*.joblib
*.keras
*.h5
*.npy

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Reports
reports/metrics/*.json
!reports/metrics/.gitkeep
!reports/plots/.gitkeep
